# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Si estas variables no se configuran, la aplicación arrancará en "Modo Demostración" (Simulación local)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-de-supabase

# Next.js migration preview (public browser configuration; never use service-role keys)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-de-supabase
NEXT_PUBLIC_OTEL_ENABLED=true
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=/api/otlp

# Slack bot token (server-side only; set the equivalent Supabase secret for Edge Functions)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ==============================================================================
# OpenTelemetry & Grafana Cloud Configuration
# ==============================================================================
# Control general de telemetría (true / false)
VITE_OTEL_ENABLED=true
VITE_OTEL_SERVICE_NAME=mateo-humanitaria

# Opción A: Envío directo a Grafana Cloud OTLP Gateway
# Reemplaza <ZONE> por tu zona de Grafana Cloud (ej. prod-us-east-0, prod-eu-west-0)
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<ZONE>.grafana.net/otlp
# VITE_OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <BASE64_INSTANCE_ID_AND_API_TOKEN>"

# Opción B: Envío a través de OpenTelemetry Collector local / Docker Compose (Recomendado)
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Credenciales para el OpenTelemetry Collector hacia Grafana Cloud (docker-compose.otel.yml)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<ZONE>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=123456
GRAFANA_CLOUD_API_KEY=glc_eyJ...
